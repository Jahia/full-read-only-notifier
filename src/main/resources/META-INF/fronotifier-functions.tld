<?xml version="1.0" encoding="UTF-8"?>
<taglib xmlns="http://java.sun.com/xml/ns/javaee"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-jsptaglibrary_2_1.xsd"
        version="2.1">
    <description>Full Read-Only Notifier EL functions</description>
    <tlib-version>1.0</tlib-version>
    <short-name>fro</short-name>
    <uri>http://www.jahia.org/community/full-read-only-notifier/functions</uri>

    <function>
        <description>
            Sanitizes stored notifier HTML against the rich-text allowlist (same allowlist the
            GraphQL mutation applies at write time), stripping executable content such as
            &lt;script&gt;, on* event handlers and javascript: hrefs. Applied at render time so the
            output is safe regardless of how the JCR property was written.
        </description>
        <name>sanitizeHtml</name>
        <function-class>org.jahia.community.fullreadonlynotifier.taglib.FronotifierFunctions</function-class>
        <function-signature>java.lang.String sanitizeHtml(java.lang.String)</function-signature>
        <example>${fro:sanitizeHtml(content_on)}</example>
    </function>
</taglib>
